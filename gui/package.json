{
  "name": "@moyin/skills-switch-gui",
  "version": "1.0.0",
  "description": "Claude Code Skills Manager - Sakura Edition",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "sync-skills": "node -e \"fetch('http://localhost:38881/api/skills/sync', {method: 'POST'}).then(r => r.json()).then(console.log).catch(console.error)\"",
    "sync-sessions": "node -e \"fetch('http://localhost:38881/api/sync/all', {method: 'POST'}).then(r => r.json()).then(console.log).catch(console.error)\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@moyin/net-client": "file:../../../common/moyin-net-client",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-virtual": "^3.0.1",
    "@uiw/react-markdown-preview": "^5.1.5",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "framer-motion": "^10.18.0",
    "fs-extra": "^11.2.0",
    "marked": "^17.0.3",
    "mermaid": "^11.12.2",
    "nodemailer": "^8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^3.7.0",
    "rehype-rewrite": "^4.0.4",
    "remark-gfm": "^4.0.1",
    "three": "^0.170.0",
    "zustand": "^4.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@pmndrs/assets": "^1.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.12",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^4.0.18"
  }
}
